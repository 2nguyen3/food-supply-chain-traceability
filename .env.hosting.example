# Cấu hình riêng bản HTTPS. Chép thành .env.hosting, KHÔNG commit file thật.
# Không chứa private key; backend không ký thay ví người dùng.
DATABASE_URL=
RPC_URL=
CHAIN_ID=11155111
CONTRACT_ADDRESS=
DEPLOY_BLOCK=
PINATA_JWT=
IPFS_GATEWAY=
MASTER_KEY=
ALLOWED_ORIGIN=
AUTH_DOMAIN=
TOKEN_TTL_MINUTES=20

# Chỉ các biến VITE_* sau được đưa vào browser. RPC cần giới hạn origin/quota.
VITE_CHAIN_ID=11155111
VITE_PUBLIC_RPC_URL=
VITE_CONTRACT_ADDRESS=
VITE_DEPLOY_BLOCK=
VITE_API_BASE_URL=
VITE_IPFS_GATEWAY=
