                    <mxGeometry x="130" y="235" width="400" height="26" as="geometry"/>
                </mxCell>
                <mxCell id="c16" value="Farmer đề nghị bàn giao cho Logistics" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="130" y="270" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c17" value="Logistics ghi nhiệt độ, vị trí; đề nghị bàn giao cho Retailer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="520" y="270" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c18" value="Retailer bán hết lô hoặc báo sự cố" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="910" y="270" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c19" value="Chỉ còn báo sự cố" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1300" y="270" width="190" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c20" value="Đề nghị bàn giao chưa đổi chủ: chỉ khi bên nhận xác minh hồ sơ và chấp nhận thì chủ lô và trạng thái mới đổi. Bị từ chối hoặc hủy thì lô giữ nguyên." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="130" y="400" width="970" height="53" as="geometry"/>
                </mxCell>
                <mxCell id="c21" value="Hai tình huống làm lô bị khóa (xảy ra ở bất kỳ trạng thái nào)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="130" y="500" width="1360" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="c22" value="&lt;b&gt;Hết hạn&lt;/b&gt;&lt;br&gt;Quá ngày hết hạn thì tự được tính là hết hạn (không lưu thêm gì trong contract). Trạng thái gốc vẫn giữ nguyên." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="150" y="546" width="420" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c23" value="&lt;b&gt;Thu hồi&lt;/b&gt;&lt;br&gt;Admin thu hồi từng lô khi có sự cố. Là cờ riêng, áp dụng cả lô đã Sold, không xóa lịch sử." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="600" y="546" width="420" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="c24" value="&lt;b&gt;Khi bị khóa&lt;/b&gt;&lt;br&gt;Không bàn giao, không nhận, không ghi nhiệt độ, không bán thêm.&lt;br&gt;Vẫn báo sự cố và thu hồi được; từ chối / hủy yêu cầu cũ vẫn được." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="1050" y="546" width="420" height="170" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
