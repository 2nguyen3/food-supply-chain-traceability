=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="50"/><mxPoint x="1310" y="50"/></Array></mxGeometry></mxCell><mxCell id="c32" value="MetaMask ký tx · trang trace đọc trực tiếp RPC / IPFS" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="20" width="520" height="25" as="geometry"/></mxCell><mxCell id="c33" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1485" y="170"/><mxPoint x="1485" y="540"/></Array></mxGeometry></mxCell><mxCell id="c34" value="JSON-RPC" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1490" y="328" width="70" height="45" as="geometry"/></mxCell><mxCell id="c35" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3500;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="recordTransit" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1090" y="498" width="80" height="45" as="geometry"/></mxCell><mxCell id="c37" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;edgeStyle=none;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="Dữ liệu lưu ở đâu"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Dữ liệu lưu ở đâu: on-chain · IPFS · PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="615" height="40" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;On-chain (Sepolia)&lt;/b&gt;&lt;hr&gt;• mã lô, farmId, harvestGroupId, farmLocation&lt;br&gt;• ngày thu hoạch / hết hạn, quantityKg = 1000&lt;br&gt;• chủ hiện tại (ownerOf), lifecycle, cờ recalled&lt;br&gt;• 3 hash SHA-256 + metadataCID (tokenURI = ipfs://CID)&lt;br&gt;• bàn giao đang chờ, sự cố, quyết định thu hồi&lt;br&gt;• vai trò (AccessControl), farmId của Farmer&lt;br&gt;• event dựng timeline: BatchCreated, Transfer, TransitRecorded...&lt;br&gt;&lt;br&gt;&lt;b&gt;Nguồn sự thật&lt;/b&gt; về owner và trạng thái lô" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="400" height="310" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;IPFS công khai (Pinata)&lt;/b&gt;&lt;hr&gt;• certificate.pdf (chứng nhận mẫu)&lt;br&gt;• batch.jpg (ảnh lô)&lt;br&gt;• metadata.json (tham chiếu 2 CID + hash)&lt;br&gt;• báo cáo sự cố (JSON/PDF mẫu)&lt;br&gt;• ciphertext hóa đơn riêng (AES-256-GCM)&lt;br&gt;&lt;br&gt;CID công khai, nhưng ciphertext không đọc được nếu thiếu khóa." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="70" width="400" height="205" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;PostgreSQL (backend)&lt;/b&gt;&lt;hr&gt;• auth_nonces: nonce đăng nhập, hết hạn, đã dùng&lt;br&gt;• sessions: hash token, hết hạn&lt;br&gt;• documents: CID, sha256, uploader, token_id, wrapped key&lt;br&gt;• document_grants: ví được đọc, thu hồi&lt;br&gt;&lt;br&gt;Dữ liệu vận hành, &lt;b&gt;không&lt;/b&gt; quyết định ownerOf hay trạng thái lô." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1.5;fontFamily=Helvetica;fontSize=15;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="400" height="226" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Không có:&lt;/b&gt; bảng tài khoản (danh tính = địa chỉ ví, vai trò đọc từ contract) · cache event trong DB · khóa của Farmer/Retailer ở backend. Trang trace công khai đọc thẳng RPC + IPFS. Token đăng nhập chỉ nằm ở sessionStorage của trình duyệt (mất khi đóng tab), không ở DB dạng rõ (DB chỉ giữ SHA-256 của token)." style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1280" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>