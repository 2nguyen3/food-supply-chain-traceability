"210" height="43" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="376" as="sourcePoint"/><mxPoint x="595" y="376" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="Giới hạn ~10 MB/file, kiểm loại nội dung và quyền uploader. Tính SHA-256 trên byte gốc trước khi upload" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="522" y="400" width="376" height="72" as="geometry"/></mxCell><mxCell id="c20" value="upload (network = public) → CID" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="605" y="490" width="210" height="43" as="geometry"/></mxCell><mxCell id="c21" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="541" as="sourcePoint"/><mxPoint x="825" y="541" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="tạo bản ghi documents ở trạng thái draft" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="605" y="565" width="440" height="23" as="geometry"/></mxCell><mxCell id="c23" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="596" as="sourcePoint"/><mxPoint x="1055" y="596" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="CID + sha256 của từng file (DApp so với SHA-256 tự tính, lệch thì dừng)" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="375" y="620" width="210" height="62" as="geometry"/></mxCell><mxCell id="c25" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="690" as="sourcePoint"/><mxPoint x="365" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="DApp tạo metadata.json tham chiếu hai CID + hash, giữ nguyên một chuỗi byte, upload qua POST /documents; backend tính SHA-256 trên byte nhận được và trả metadataCID + hash để DApp đối chiếu. (đã chốt 21/10/2026)" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="292" y="714" width="606" height="72" as="geometry"/></mxCell><mxCell id="c27" value="createBatch(thông tin lô, metadataCID, 3 hash) — ký bằng MetaMask" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="145" y="804" width="1130" height="23" as="geometry"/></mxCell><mxCell id="c28" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="835" as="sourcePoint"/><mxPoint x="1285" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="Kiểm FARMER_ROLE + farmId, mã lô duy nhất, quantityKg = 1000, harvestDate ≤ now &lt; expiryDate. Mint NFT + set tokenURI = ipfs://metadataCID trong cùng giao dịch" style="shape=note;size=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;fontSize=14;fon