# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env. File này chỉ chứa giá trị giả.

# --- PostgreSQL cục bộ (docker-compose.yml, chỉ dùng khi dev) ---
# Một container, hai database riêng: food_dev (chạy backend) và food_test (pytest).
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_dev_only
DEV_DB_NAME=food_dev
DEV_DB_USER=food_dev
DEV_DB_PASSWORD=change_me_dev_only
TEST_DB_NAME=food_test
TEST_DB_USER=food_test
TEST_DB_PASSWORD=change_me_test_only

# --- Backend ---
# Mật khẩu trong URL phải trùng DEV_DB_PASSWORD / TEST_DB_PASSWORD; chỉ dùng chữ và số cho an toàn.
# Dùng 127.0.0.1 chứ không dùng localhost: localhost thử IPv6 trước và treo rất lâu với Docker Desktop.
DATABASE_URL=postgresql+psycopg://food_dev:change_me_dev_only@127.0.0.1:5432/food_dev
# pytest chỉ chạy khi tên database kết thúc bằng _test.
TEST_DATABASE_URL=postgresql+psycopg://food_test:change_me_test_only@127.0.0.1:5432/food_test
# Dev local: RPC_URL=http://127.0.0.1:8545 và CHAIN_ID=31337
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOY_BLOCK=0
PINATA_JWT=your_pinata_jwt_here
MASTER_KEY=replace_with_64_hex_chars
ALLOWED_ORIGIN=http://localhost:5173
AUTH_DOMAIN=localhost:5173
TOKEN_TTL_MINUTES=20

# --- Contract (chỉ ví testnet, không dùng ví tiền thật) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_PRIVATE_KEY=your_testnet_private_key_here
